{
  "name": "powersync-workspace",
  "private": true,
  "description": "PowerSync CLI monorepo",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/compat": "^1.4.1",
    "eslint": "^9.39.4",
    "eslint-config-oclif": "^6.0.160",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "powersync": "workspace:*",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "changeset:version": "pnpm changeset version && pnpm -r --if-present run version && pnpm install --lockfile-only --frozen-lockfile=false",
    "release": "pnpm build:packages && pnpm changeset publish",
    "format:write": "pnpm prettier --write .",
    "lint:fix": "pnpm -r --if-present run lint --fix",
    "test": "pnpm -r run test",
    "configure-hooks": "husky",
    "prepare": "husky",
    "powersync-dev": "pnpm  -C cli run  build && pnpm exec node --inspect --enable-source-maps --import  tsx ./cli/bin/dev.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
